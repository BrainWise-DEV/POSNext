+import { computed } from "vue";
+
+const props = defineProps({
+	modelValue: Boolean,
+	allowWithoutInvoice: { type: Boolean, default: false },
+	allowExchange: { type: Boolean, default: true },
+});
+const emit = defineEmits(["update:modelValue", "select"]);
+const show = computed({
+	get: () => props.modelValue,
